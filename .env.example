# CognoDB Cloud credentials
COGNODB_URI=bolt+s://your-cognodb-instance:7687
COGNODB_USER=cognodb
COGNODB_PASSWORD=secret

# Neo4j Local
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Memgraph Local
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ArangoDB Local
ARANGO_URI=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=password
ARANGO_DATABASE=benchmark_db

# FalkorDB Local
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=benchmark_graph
