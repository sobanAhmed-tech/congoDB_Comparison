# CognoDB Cloud credentials
COGNODB_URI=bolt+s://your-cognodb-instance:7687
COGNODB_USER=cognodb
COGNODB_PASSWORD=secret

# Neo4j Cloud (e.g. Neo4j Aura)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Memgraph Cloud
MEMGRAPH_URI=bolt+s://your-instance.memgraph.cloud:7687
MEMGRAPH_USER=your_user
MEMGRAPH_PASSWORD=your_password

# ArangoDB Cloud (ArangoGraph)
ARANGO_URI=https://your-instance.arangodb.cloud:8529
ARANGO_USER=root
ARANGO_PASSWORD=your_password
ARANGO_DATABASE=benchmark_db

# FalkorDB Cloud
FALKORDB_HOST=your-instance.falkordb.cloud
FALKORDB_PORT=6379
FALKORDB_PASSWORD=your_password
FALKORDB_GRAPH_NAME=benchmark_graph
